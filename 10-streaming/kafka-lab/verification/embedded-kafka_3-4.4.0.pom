<?xml version='1.0' encoding='UTF-8'?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <groupId>io.github.embeddedkafka</groupId>
    <artifactId>embedded-kafka_3</artifactId>
    <packaging>jar</packaging>
    <description>embedded-kafka</description>
    <url>https://github.com/embeddedkafka/embedded-kafka</url>
    <version>4.4.0</version>
    <licenses>
        <license>
            <name>MIT</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <name>embedded-kafka</name>
    <organization>
        <name>io.github.embeddedkafka</name>
        <url>https://github.com/embeddedkafka/embedded-kafka</url>
    </organization>
    <scm>
        <url>https://github.com/embeddedkafka/embedded-kafka</url>
        <connection>scm:git:https://github.com/embeddedkafka/embedded-kafka.git</connection>
        <developerConnection>scm:git:git@github.com:embeddedkafka/embedded-kafka.git</developerConnection>
    </scm>
    <developers>
        <developer>
            <id>manub</id>
            <name>Emanuele Blanco</name>
            <url>https://twitter.com/manub</url>
            <email>emanuele.blanco@gmail.com</email>
        </developer>
        <developer>
            <id>francescopellegrini</id>
            <name>Francesco Pellegrini</name>
            <url>https://github.com/francescopellegrini</url>
            <email>francesco.pelle@gmail.com</email>
        </developer>
        <developer>
            <id>NeQuissimus</id>
            <name>Tim Steinbach</name>
            <url>https://github.com/NeQuissimus</url>
            <email>steinbach.tim@gmail.com</email>
        </developer>
    </developers>
    <properties>
        <info.versionScheme>semver-spec</info.versionScheme>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.scala-lang</groupId>
            <artifactId>scala3-library_3</artifactId>
            <version>3.3.8</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-reload4j</artifactId>
            <version>2.0.20</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.scalatest</groupId>
            <artifactId>scalatest-wordspec_3</artifactId>
            <version>3.2.20</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.scalatest</groupId>
            <artifactId>scalatest-shouldmatchers_3</artifactId>
            <version>3.2.20</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.kafka</groupId>
            <artifactId>kafka_2.13</artifactId>
            <version>4.4.0</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.module</groupId>
            <artifactId>jackson-module-scala_3</artifactId>
            <version>2.21.7.1</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>